# PostgreSQL connection (Neon/Supabase/RDS in production)
DATABASE_URL="postgresql://user:password@host:5432/gurukul"
# Secret for signing session cookies — generate with: openssl rand -hex 32
AUTH_SECRET="change-me"
# Initial admin password used by `prisma db seed` (admin@gurukul.edu)
SEED_ADMIN_PASSWORD="admin123"
# Brevo (formerly Sendinblue) API key for transactional emails
BREVO_API_KEY="your-brevo-api-key"
# Optional: override sender identity (must be verified in Brevo)
BREVO_SENDER_EMAIL="noreply@gurukul.edu"
BREVO_SENDER_NAME="Gurukul"
